# Chuyển mọi URL "đẹp" (/tim-san, /san/ten-san, ...) về index.php
Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Không cho tải trực tiếp thư mục database, includes, pages, git
  RewriteRule ^(database/|includes/|pages/|\.git) - [F,L]
  # File hoặc thư mục có thật thì trả về luôn (css, js, ảnh, api/*.php)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.php [QSA,L]
</IfModule>

AddDefaultCharset UTF-8
